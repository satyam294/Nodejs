<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home Page</title>
  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: large;
    }
    .form {
      margin-bottom: 10px;
    }
    table {
      border-collapse: collapse;
      width: 100%;
    }
    th,
    td {
      border: 1px solid #ccc;
      padding: 8px;
      text-align: left;
    }
    th {
      background-color: #f2f2f2;
    }
  </style>
</head>

<body>
  <h1>URL Shortener</h1>

  <% if (locals.shortId) { %>
  <p>Short Url: http://localhost:8000/url/<%= shortId %></p>
  <% } %>

  <div class="form">
    <form method="post" action="/url">
      <label>Enter the original url</label>
      <input type="text" name="url" placeholder="https://www.example.com">
      <button type="submit"> Generate </button>
    </form>
  </div>

  <% if (locals.urls) { %>
  <div>
    <table> 
      <thead>
        <tr>
          <th>S. No.</th>
          <th>Short Id</th>
          <th>Redirect Url</th>
          <th>Clicks</th>
        </tr>
      </thead>

      <tbody>
        <% urls.forEach((url, i) => { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= url.shortUrl %></td>
          <td><%= url.redirectUrl %></td>
          <td><%= url.visitHistory.length %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</body>

</html>